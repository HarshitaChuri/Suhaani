# MongoDB Atlas connection string (get from Atlas dashboard -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pcos_platform?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ML microservice URL (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
